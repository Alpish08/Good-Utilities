<?xml version="1.0" encoding="utf-8"?>
<!-- One UI menu: grows from the top-right corner while fading in. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <scale android:fromXScale="0.85" android:toXScale="1" android:fromYScale="0.85" android:toYScale="1"
        android:pivotX="100%" android:pivotY="0%" android:duration="240" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="160" />
</set>
