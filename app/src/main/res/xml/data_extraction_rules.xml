<?xml version="1.0" encoding="utf-8"?>
<!-- ID cards and the Briefs login never leave the phone: kept out of cloud backups and device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="idcards/" />
        <exclude domain="sharedpref" path="briefs_account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="idcards/" />
        <exclude domain="sharedpref" path="briefs_account.xml" />
    </device-transfer>
</data-extraction-rules>
