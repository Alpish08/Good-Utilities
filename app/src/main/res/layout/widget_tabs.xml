<?xml version="1.0" encoding="utf-8"?>
<!-- Good Utilities' bottom tab pill as a widget (tabs 66 dp apart, like the app). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_tabs_bg"
        android:orientation="horizontal"
        android:paddingHorizontal="7dp">
        <LinearLayout
            android:id="@+id/tab0"
            android:layout_width="66dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_tab_press"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/icon0"
                android:layout_width="22.3dp"
                android:layout_height="22.3dp"
                android:layout_marginTop="8.35dp"
                android:importantForAccessibility="no"
                android:tint="@color/widget_tab" />
            <TextView
                android:id="@+id/label0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:firstBaselineToTopHeight="12.35dp"
                android:fontFamily="sec"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:maxLines="1"
                android:text="Media"
                android:textColor="@color/widget_tab"
                android:textFontWeight="500"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab1"
            android:layout_width="66dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_tab_press"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/icon1"
                android:layout_width="22.3dp"
                android:layout_height="22.3dp"
                android:layout_marginTop="8.35dp"
                android:importantForAccessibility="no"
                android:tint="@color/widget_tab" />
            <TextView
                android:id="@+id/label1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:firstBaselineToTopHeight="12.35dp"
                android:fontFamily="sec"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:maxLines="1"
                android:text="Files"
                android:textColor="@color/widget_tab"
                android:textFontWeight="500"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab2"
            android:layout_width="66dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_tab_press"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/icon2"
                android:layout_width="22.3dp"
                android:layout_height="22.3dp"
                android:layout_marginTop="8.35dp"
                android:importantForAccessibility="no"
                android:tint="@color/widget_tab" />
            <TextView
                android:id="@+id/label2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:firstBaselineToTopHeight="12.35dp"
                android:fontFamily="sec"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:maxLines="1"
                android:text="Images"
                android:textColor="@color/widget_tab"
                android:textFontWeight="500"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab3"
            android:layout_width="66dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_tab_press"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/icon3"
                android:layout_width="22.3dp"
                android:layout_height="22.3dp"
                android:layout_marginTop="8.35dp"
                android:importantForAccessibility="no"
                android:tint="@color/widget_tab" />
            <TextView
                android:id="@+id/label3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:firstBaselineToTopHeight="12.35dp"
                android:fontFamily="sec"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:maxLines="1"
                android:text="Device"
                android:textColor="@color/widget_tab"
                android:textFontWeight="500"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab4"
            android:layout_width="66dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_tab_press"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/icon4"
                android:layout_width="22.3dp"
                android:layout_height="22.3dp"
                android:layout_marginTop="8.35dp"
                android:importantForAccessibility="no"
                android:tint="@color/widget_tab" />
            <TextView
                android:id="@+id/label4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:firstBaselineToTopHeight="12.35dp"
                android:fontFamily="sec"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:maxLines="1"
                android:text="Misc"
                android:textColor="@color/widget_tab"
                android:textFontWeight="500"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
