<?xml version="1.0" encoding="utf-8"?>
<!-- Press highlight for a widget tab: a capsule like the app's, shown only while pressed (no padding added). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="350">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="5dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="@color/widget_tab_pressed" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
